{
  "schemaVersion": 1,
  "id": "advancements_search",
  "version": "1.3.1",
  "name": "Advancements Search",
  "description": "A client-side mod that adds a search feature to the advancements window.",
  "authors": [
    "diskria"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/advancements-search",
    "sources": "https://github.com/diskria-minecraft/advancements-search",
    "issues": "https://github.com/diskria-minecraft/advancements-search/issues"
  },
  "license": "MIT",
  "icon": "assets/advancements_search/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "value": "io.github.diskria.advancements_search.AdvancementsSearchMod",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    {
      "config": "advancements_search.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "advancements_search.classtweaker",
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=26.3",
    "java": ">=25",
    "fabric-language-kotlin": ">=1.13.12+kotlin.2.4.0"
  }
}
